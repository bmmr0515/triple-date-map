# ==========================================
# トリプルデートマップ 環境変数テンプレート
# ==========================================
# ローカル開発時は本ファイルをコピーして .env を作成し、
# 実際のプロジェクト設定値を設定してください。
# ※ .env は Git の追跡対象外（.gitignore）です。

# ------------------------------------------
# 1. Supabase 接続設定（公開可能キー）
# ------------------------------------------
# SupabaseプロジェクトのAPI URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase公開用Anonキー（JWT role: anon）
# ※クライアント側（ブラウザ）で動作する公開鍵です。
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------
# 2. 管理画面・管理者設定（機密情報）
# ------------------------------------------
# 管理者認証用パスワード（本番環境ではVercel等の環境変数設定で設定してください）
VITE_ADMIN_PASSWORD=your-secure-admin-password

# ------------------------------------------
# 3. アプリケーション動作フラグ
# ------------------------------------------
# メンテナンスモードフラグ (true: メンテナンス中, false: 通常運用)
VITE_MAINTENANCE_MODE=false
